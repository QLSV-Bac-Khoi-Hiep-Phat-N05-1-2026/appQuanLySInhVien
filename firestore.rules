rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().get('status', '') == 'active'; }
    function admin() { return active() && profile().role == 'admin'; }
    function lecturer() { return active() && profile().role == 'lecturer' && request.auth.token.email_verified == true; }
    function student() { return active() && profile().role == 'student'; }
    function code(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,80}$'); }
    function text(value,max) { return value is string && value.size()>0 && value.size()<=max && value.matches('.*[^ \\t\\r\\n].*'); }
    function email(value) { return value is string && value.size()<=254 && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'); }
    function ownsClass(id) { return lecturer() && id is string && exists(/databases/$(database)/documents/classes/$(id)) && get(/databases/$(database)/documents/classes/$(id)).data.get('lecturerId',null) == request.auth.uid; }
    function ownStudent(id) { return student() && profile().get('studentId',null) == id; }
    function managesStudent(id) { return admin() || (lecturer() && exists(/databases/$(database)/documents/students/$(id)) && ownsClass(get(/databases/$(database)/documents/students/$(id)).data.classId)); }
    function validUser(d) {
      return d.keys().hasAll(['email','displayName','role','status','studentId','lecturerCode','phone','contactEmail','address'])
        && d.keys().hasOnly(['email','displayName','role','status','studentId','lecturerCode','phone','contactEmail','address','reviewedBy','reviewedAt'])
        && email(d.email) && text(d.displayName,150)
        && d.role in ['admin','lecturer','student'] && d.status in ['active','pending','rejected','suspended']
        && (d.studentId == null || code(d.studentId)) && (d.role != 'student' || code(d.studentId))
        && d.lecturerCode is string && d.lecturerCode.size()<=80
        && d.phone is string && (d.phone == '' || d.phone.matches('^[+0-9 ()-]{8,20}$'))
        && (d.contactEmail == '' || email(d.contactEmail)) && d.address is string && d.address.size()<=300;
    }
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || admin()
        || (lecturer() && resource.data.role == 'student' && managesStudent(resource.data.studentId));
      allow list: if admin();
      allow update: if active() && request.auth.uid == uid && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          student() ? ['phone','contactEmail','address'] : ['displayName','phone','contactEmail','address']);
      // Provisioning, roles, status and student binding are server-only operations.
      allow create, delete: if false;
    }
    function validClass(id,d) {
      return code(id) && d.keys().hasAll(['name','major','cohort'])
        && d.keys().hasOnly(['name','major','cohort','lecturerId','lecturerName'])
        && text(d.name,150) && text(d.major,150) && text(d.cohort,30)
        && (d.get('lecturerId',null) == null || (d.lecturerId is string && d.lecturerId.size()>0 && d.lecturerId.size()<=128))
        && (d.get('lecturerName',null) == null || text(d.lecturerName,150));
    }
    match /classes/{id} {
      allow read: if admin() || (lecturer() && resource.data.get('lecturerId',null) == request.auth.uid) || (student() && exists(/databases/$(database)/documents/students/$(profile().studentId)) && get(/databases/$(database)/documents/students/$(profile().studentId)).data.classId == id);
      allow create: if admin() && validClass(id,request.resource.data) && request.resource.data.get('lecturerId',null) == null && request.resource.data.get('lecturerName',null) == null;
      allow update: if (admin() || ownsClass(id)) && validClass(id,request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','major','cohort']);
      allow delete: if false;
    }
    function validStudent(id,d) {
      return code(id) && d.keys().hasAll(['name','major','age','classId','email'])
        && d.keys().hasOnly(['name','major','age','classId','email','accountUid'])
        && text(d.name,150) && text(d.major,150) && d.age is int && d.age>=1 && d.age<=120
        && (d.email == '' || email(d.email))
        && (d.classId == null || (code(d.classId) && exists(/databases/$(database)/documents/classes/$(d.classId))))
        && (d.get('accountUid',null) == null || (d.accountUid is string && d.accountUid.size()>0 && d.accountUid.size()<=128));
    }
    match /students/{id} {
      allow read: if admin() || ownStudent(id) || ownsClass(resource.data.classId);
      allow create: if (admin() || ownsClass(request.resource.data.classId)) && validStudent(id,request.resource.data) && request.resource.data.get('accountUid',null) == null;
      allow update: if (admin() || (ownsClass(resource.data.classId) && ownsClass(request.resource.data.classId)))
        && validStudent(id,request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','major','age','classId','email']);
      allow delete: if false;
    }
    function validSubject(id,d) { return code(id) && d.keys().hasAll(['name','credits']) && d.keys().hasOnly(['name','credits']) && text(d.name,150) && d.credits is int && d.credits>=1 && d.credits<=10; }
    match /subjects/{id} {
      allow read: if active() && (profile().role in ['admin','student'] || lecturer());
      allow create, update: if admin() && validSubject(id,request.resource.data);
      allow delete: if false;
    }
    function validGrade(id,d) {
      return d.keys().hasAll(['studentId','subjectId','semester','score']) && d.keys().hasOnly(['studentId','subjectId','semester','score'])
        && code(d.studentId) && code(d.subjectId) && d.semester is string && d.semester.matches('^[0-9]{4}-[12]$')
        && id == d.studentId+'~'+d.subjectId+'~'+d.semester
        && d.score is number && d.score>=0 && d.score<=10
        && exists(/databases/$(database)/documents/students/$(d.studentId)) && exists(/databases/$(database)/documents/subjects/$(d.subjectId));
    }
    match /grades/{id} {
      allow read: if managesStudent(resource.data.studentId) || ownStudent(resource.data.studentId);
      allow create: if managesStudent(request.resource.data.studentId) && validGrade(id,request.resource.data);
      allow update: if managesStudent(resource.data.studentId) && managesStudent(request.resource.data.studentId) && validGrade(id,request.resource.data);
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
